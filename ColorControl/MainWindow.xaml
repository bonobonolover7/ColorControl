<Window x:Class="ColorControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Color Control"
        Width="500"
        Height="600"
        Background="#000000">

    <Window.Resources>

        <Style x:Key="DarkButtonStyle"
               TargetType="Button">

            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#151515"/>
                    <Setter Property="BorderBrush" Value="#666666"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#080808"/>
                    <Setter Property="BorderBrush" Value="#888888"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <StackPanel Margin="30">

        <TextBlock
            Text="Display Color Control"
            Foreground="White"
            FontSize="28"
            FontWeight="Bold"
            Margin="0,0,0,30"/>

        <TextBlock
            Text="Gamma"
            Foreground="White"
            FontSize="16"/>

        <Slider
            x:Name="GammaSlider"
            Minimum="0.5"
            Maximum="2.0"
            Value="1.0"
            Margin="0,5,0,25"
            PreviewMouseDown="Slider_PreviewMouseDown"/>

        <TextBlock
            Text="Red"
            Foreground="White"
            FontSize="16"/>

        <Slider
            x:Name="RedSlider"
            Minimum="0"
            Maximum="200"
            Value="100"
            Margin="0,5,0,20"
            PreviewMouseDown="Slider_PreviewMouseDown"/>

        <TextBlock
            Text="Green"
            Foreground="White"
            FontSize="16"/>

        <Slider
            x:Name="GreenSlider"
            Minimum="0"
            Maximum="200"
            Value="100"
            Margin="0,5,0,20"
            PreviewMouseDown="Slider_PreviewMouseDown"/>

        <TextBlock
            Text="Blue"
            Foreground="White"
            FontSize="16"/>

        <Slider
            x:Name="BlueSlider"
            Minimum="0"
            Maximum="200"
            Value="100"
            Margin="0,5,0,30"
            PreviewMouseDown="Slider_PreviewMouseDown"/>

        <Button
            Content="적용"
            Height="45"
            Click="ApplyButton_Click"
            Style="{StaticResource DarkButtonStyle}"/>

        <Button
            Content="기본값"
            Height="45"
            Margin="0,10,0,0"
            Click="ResetButton_Click"
            Style="{StaticResource DarkButtonStyle}"/>

    </StackPanel>

</Window>
